# Copy to .env and fill in. Never commit .env.

# --- source chain: Ethereum Sepolia -------------------------------------------------
# The tutorial tells you to sign up for Infura. You do not need to: this public endpoint
# served every call during development, including eth_getLogs and receipts.
SOURCE_CHAIN_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"
SOURCE_CHAIN_KEY=1

# --- Creditcoin CC3 testnet ----------------------------------------------------------
CREDITCOIN_RPC_URL="https://rpc.cc3-testnet.creditcoin.network"
PROOF_BUILDER_URL="https://prover.cc3-testnet.creditcoin.network"

# --- keys ----------------------------------------------------------------------------
# Throwaway accounts only. Generate with: cast wallet new
DEPLOYER_PRIVATE_KEY=
WORKER_PRIVATE_KEY=

# --- deployed addresses, filled in by script/Deploy.s.sol -----------------------------
SOURCE_ESCROW_ADDRESS=
ENCLAVE_REGISTRY_ADDRESS=
COMPUTE_CREDIT_ADDRESS=
SETTLEMENT_ADDRESS=
REGISTRAR_ADDRESS=

# --- enclave --------------------------------------------------------------------------
# Point at the running Confidential Space workload. When this is unset the worker falls back
# to an unattested local signer and says so loudly on every run.
ENCLAVE_URL=
DEV_ENCLAVE_PRIVATE_KEY=

# Used by script/Deploy.s.sol:RegisterEnclave
ENCLAVE_MEASUREMENT=
ENCLAVE_SIGNING_KEY=
ENCLAVE_EVIDENCE_HASH=
ENCLAVE_EVIDENCE_URI=

# Optional: start the worker from a specific Sepolia block instead of the head
WORKER_FROM_BLOCK=
